Name     esd;
PartNo   00;
Date     10/4/2024;
Revision 01;
Designer Engineer;
Company  University of Colorado Boulder;
Assembly None;
Location;
Device   g16v8a;

/* *************** INPUT PINS *********************/
PIN  2 = EA;    /* External Access control          */
PIN  3 = A15;   /* Address line 15                  */
PIN  4 = RD;    /* Read control signal              */
PIN  5 = WR;    /* Write control signal             */
PIN  6 = PSEN;  /* Program Store Enable             */

/* *************** OUTPUT PINS *********************/
PIN 12 = CE;    /* Chip Enable for memory           */
PIN 13 = OE;    /* Output Enable                    */
PIN 14 = 374_CE;/* Chip Enable for 74LS374 latch    */

/* *************** LOGIC EQUATIONS *****************/
CE = (EA & A15) # (RD $ WR);
OE = PSEN;
374_CE = !A15 & !WR;


