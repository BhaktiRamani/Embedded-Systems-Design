                      ain.obj) EP

LOC  OBJ            LINE     SOURCE

                       1     ;Author : Bhakti Ramani
                       2     ; ESD LAB 1 Part 1
                       3     ; Description : 
                       4             ;Internal data memory (IRAM) location 0x20 contains the value of (X)
                       5             ; IRAM location 0x21 contains the value of (X*4)
                       6             ; IRAM location 0x22 contains the value of (Y)
                       7             ; IRAM location 0x23 contains Z, the 8-bit quotient (in hexadecimal)
                       8             ; IRAM location 0x24 contains the 8-bit remainder (in hexadecimal)
                       9             ; IRAM location 0x30 contains the error code.
                      10             
                      11     
0000                  12     ORG 0000H
                      13     
                      14     ; Enter value of X in R0 register via debugging in register window
0000 E8               15     MOV A, R0;
0001 7820             16     MOV R0, #20H
0003 F6               17     MOV @R0, A;
                      18     
                      19     ; Enter value of X in R0 register via debugging in register window
0004 89F0             20     MOV B, R1;
0006 7922             21     MOV R1, #22H
0008 A7F0             22     MOV @R1, B;
                      23     
                      24     ; CHECK FOR ZERO
000A 6030             25     JZ IS_ZERO;                             ; If accumulator is zero
000C F8               26     MOV R0, A;                              ; Preserving A value
000D E5F0             27     MOV A, B;
000F 602B             28     JZ IS_ZERO;                             ; If B is zero(indirectly checking via accumulator)
0011 E8               29     MOV A, R0;
                      30     
                      31     
                      32     
                      33     
                      34     ; ROTATION (A>>2 = A*4)
0012 C3               35     CLR C;
0013 33               36     RLC A
0014 402D             37     JC OVERFLOW                     ; If carry is set, we have overflow
0016 33               38     RLC A                           ; Rotate left again
0017 402A             39     JC OVERFLOW                             ; If carry is set, we have overflow
                      40     
                      41     
0019 7821             42     MOV R0, #21H;                           ; Store result(A*4) at address 21H
001B F6               43     MOV @R0, A;
                      44     
001C A8F0             45     MOV R0, B                                       ; Load B into R0 for later use
                      46     
001E 7900             47     MOV R1, #00H                            ; Initialize R1 to 0 for divison
                      48     
0020                  49     DIV_LOOP:
0020 C3               50             CLR C;
0021 95F0             51             SUBB A, B;                              ; Subtract B from A with borrow
0023 5002             52             JNC DIV_OK;                             ; Jump to DIV_OK if no borrow is occured   
                                                  
                      53             
0025 8003             54             SJMP DIV_RESULT;                ; Skip to DIV_RESULT if borrow occured
                      55             
0027                  56     DIV_OK:
A51 MACRO ASSEMBLER  MAIN                                                                 09/06/2024 12:44:28 PAGE     2

0027 09               57             INC R1;                                 ; Increment quotient
0028 80F6             58             SJMP DIV_LOOP;                  ; Repeat divison loop
                      59             
002A                  60     DIV_RESULT:
002A 25F0             61         ADD A, B;                           ; Add B to A to get the remainder
002C 7823             62             MOV R0, #23H;                   ; Store result at address 23H
002E F6               63             MOV @R0, A;
                      64             
002F 89F0             65             MOV B, R1;                              ; Store quotient in B
0031 7824             66             MOV R0, #24H;                   ; Store quotient at address 24H
0033 A6F0             67             MOV @R0, B;
                      68             
0035 7830             69             MOV R0, #30H;                   ; Set error code to 00H(No errors)
0037 7600             70             MOV @R0, #00H;
0039 02004A           71             LJMP _END;                              ; JMP to end
                      72             
003C                  73     IS_ZERO:
003C 7830             74             MOV R0, #30H;                   ; Set error code to 01H(zero error)
003E 7601             75             MOV @R0, #01H;
0040 02004A           76             LJMP _END;                              ; Jmp to end
                      77             
0043                  78     OVERFLOW:
0043 7830             79             MOV R0, #30H;                   ; Set error code to 02H(overflow error)
0045 7602             80             MOV @R0, #02H;
0047 02004A           81             LJMP _END;                              ; JMP to end    
                      82     
004A                  83     _END:
004A 02004A           84             LJMP _END                               ; Infinite loop
                      85     
                      86     END
